        "desc": {
            "en": "Parental controls for Amazon Kids profiles on Fire tablets: read time limits, pause devices and grant bonus time",
            "de": "Kindersicherung für Amazon-Kids-Profile auf Fire-Tablets: Zeitlimits lesen, Geräte pausieren und Bonuszeit vergeben",
            "ru": "Родительский контроль для профилей Amazon Kids на планшетах Fire: чтение лимитов времени, приостановка устройств и бонусное время",
            "pt": "Controlo parental para perfis Amazon Kids em tablets Fire: ler limites de tempo, pausar dispositivos e conceder tempo extra",
            "nl": "Ouderlijk toezicht voor Amazon Kids-profielen op Fire-tablets: tijdslimieten lezen, apparaten pauzeren en bonustijd geven",
            "fr": "Contrôle parental pour les profils Amazon Kids sur tablettes Fire : lire les limites de temps, mettre les appareils en pause et accorder du temps bonus",
            "it": "Controllo genitori per i profili Amazon Kids sui tablet Fire: leggere i limiti di tempo, mettere in pausa i dispositivi e concedere tempo bonus",
            "es": "Control parental para perfiles de Amazon Kids en tabletas Fire: leer límites de tiempo, pausar dispositivos y conceder tiempo extra",
            "pl": "Kontrola rodzicielska dla profili Amazon Kids na tabletach Fire: odczyt limitów czasu, wstrzymywanie urządzeń i przyznawanie dodatkowego czasu",
            "uk": "Батьківський контроль для профілів Amazon Kids на планшетах Fire: читання лімітів часу, призупинення пристроїв і бонусний час",
            "zh-cn": "适用于 Fire 平板电脑上 Amazon Kids 配置文件的家长控制：读取时间限制、暂停设备并给予奖励时间"
        },
        "authors": ["Henrik Schönhofen <henrik.schoenhofen@gmx.de>"],
        "keywords": ["amazon kids", "fire tablet", "parental control", "parent dashboard", "screen time"],
        "licenseInformation": {
            "type": "free",
            "license": "MIT"
        },
        "platform": "Javascript/Node.js",
        "icon": "amazon-kids.png",
        "enabled": true,
        "extIcon": "https://raw.githubusercontent.com/backfisch88/ioBroker.amazon-kids/main/admin/amazon-kids.png",
        "readme": "https://github.com/backfisch88/ioBroker.amazon-kids/blob/main/README.md",
        "loglevel": "info",
        "tier": 3,
        "mode": "daemon",
        "type": "household",
        "compact": false,
        "connectionType": "cloud",
        "dataSource": "poll",
        "adminUI": {
            "config": "json"
        },
        "dependencies": [
            {
                "js-controller": ">=6.0.11"
            }
        ],
        "globalDependencies": [
            {
                "admin": ">=7.8.23"
            }
        ]
    },
    "native": {
        "baseUrl": "https://eltern.amazon.de",
        "pollInterval": 15,
        "timeZone": "",
        "proxyOwnIp": "",
        "proxyPort": 3457,
        "cookies": ""
    },
    "protectedNative": ["cookies"],
    "encryptedNative": ["cookies"],
    "objects": [],
    "instanceObjects": [
        {
            "_id": "info",
            "type": "channel",
            "common": {
                "name": "Information"
            },
            "native": {}
        },
        {
            "_id": "info.connection",
            "type": "state",
            "common": {
                "role": "indicator.connected",
                "name": "Connected to the Parent Dashboard",
                "type": "boolean",
                "read": true,
                "write": false,
                "def": false
            },
            "native": {}
        },
        {
            "_id": "info.loginUrl",
            "type": "state",
            "common": {
                "role": "url",
                "name": "Address of the Amazon login page",
                "type": "string",
                "read": true,
                "write": false,
                "def": ""
            },
            "native": {}
        },
        {
            "_id": "info.login",
            "type": "state",
            "common": {
                "role": "button",
                "name": "Start a new Amazon login",
                "type": "boolean",
                "read": false,
                "write": true
            },
            "native": {}
        },
        {
            "_id": "info.discover",
            "type": "state",
            "common": {
                "role": "button",
                "name": "List the endpoints of the Parent Dashboard (diagnosis)",
                "type": "boolean",
                "read": false,
                "write": true
            },
            "native": {}
        },
        {
            "_id": "info.endpoints",
            "type": "state",
            "common": {
                "role": "json",
                "name": "Endpoints found by the diagnosis",
                "type": "string",
                "read": true,
                "write": false,
                "def": ""
            },
            "native": {}
        },
        {
            "_id": "household",
            "type": "channel",
            "common": {
                "name": "All children"
            },
            "native": {}
        },
        {
            "_id": "household.pause",
            "type": "state",
            "common": {
                "role": "level",
                "name": "Pause the devices of all children for the given minutes (0 = resume), returns to 0 after sending",
                "type": "number",
                "unit": "min",
                "min": 0,
                "max": 1440,
                "def": 0,
                "read": true,
                "write": true
            },
            "native": {}
        },
        {
            "_id": "household.resume",
            "type": "state",
            "common": {
                "role": "button",
                "name": "Resume the devices of all children",
                "type": "boolean",
                "read": false,
                "write": true
            },
            "native": {}
        }
    ]
}
