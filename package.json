        "email": "henrik.schoenhofen@gmx.de"
    },
    "homepage": "https://github.com/backfisch88/ioBroker.amazon-kids",
    "license": "MIT",
    "keywords": [
        "ioBroker",
        "amazon kids",
        "fire tablet",
        "parental control",
        "screen time"
    ],
    "repository": {
